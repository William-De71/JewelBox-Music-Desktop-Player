<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.william_de71.JewelBox</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>JewelBox Music Player</name>
  <summary>Écoutez votre bibliothèque musicale JewelBox</summary>
  <description>
    <p>
      Client de streaming pour le serveur JewelBox Music Library : parcourez
      votre collection d'albums, écoutez vos pistes, gérez vos playlists et
      laissez le mix dynamique tourner. Aucune bibliothèque locale : tout est
      lu depuis votre serveur sur le réseau local.
    </p>
  </description>
  <launchable type="desktop-id">io.github.william_de71.JewelBox.desktop</launchable>
  <developer id="io.github.william-de71">
    <name translate="no">William Deren</name>
  </developer>
  <url type="homepage">https://github.com/William-De71/JewelBox-Music-Desktop-Player</url>
  <url type="bugtracker">https://github.com/William-De71/JewelBox-Music-Desktop-Player/issues</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#c061cb</color>
    <color type="primary" scheme_preference="dark">#613583</color>
  </branding>
  <!--
    Le premier <release> doit toujours porter la version du projet déclarée
    dans meson.build : c'est lui qu'AppStream expose comme version publiée
    (GNOME Logiciels, `flatpak remote-ls`). release.sh insère la nouvelle
    entrée automatiquement, et la CI échoue si les deux divergent.
  -->
  <releases>
    <release version="0.6.1" date="2026-08-11">
      <description>
        <p>Correction de la version affichée dans GNOME Logiciels.</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-08-11">
      <description>
        <p>Reprise de la lecture là où elle s'était arrêtée, et fenêtre
        redimensionnable sans rognage du contenu.</p>
      </description>
    </release>
    <release version="0.5.3" date="2026-08-09">
      <description>
        <p>Icône cœur pour les favoris, à la place de l'étoile.</p>
      </description>
    </release>
    <release version="0.5.2" date="2026-07-23">
      <description>
        <p>Playlists intelligentes dans les récents, nom de la source dans les
        lecteurs et corrections de la mise en page d'accueil.</p>
      </description>
    </release>
    <release version="0.5.1" date="2026-07-21">
      <description>
        <p>Préchargement de la piste suivante dans l'ordre de lecture plutôt
        que dans l'ordre d'affichage.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-07-21">
      <description>
        <p>Onglet playlists (utilisateur et intelligentes), recherche dans la
        bibliothèque, lecture rapide depuis les cartes d'album et nouveautés
        sur l'accueil.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-07-21">
      <description>
        <p>Améliorations de la navigation et de la lecture.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-07-21">
      <description>
        <p>Parcours de la bibliothèque et lecture des pistes.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-07-21">
      <description>
        <p>Corrections de la connexion au serveur.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-21">
      <description>
        <p>Connexion au serveur JewelBox Music Library.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-19">
      <description>
        <p>Squelette initial de l'application.</p>
      </description>
    </release>
  </releases>
</component>
